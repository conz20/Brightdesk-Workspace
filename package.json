{
  "name": "brightdesk-workspace",
  "version": "0.1.0",
  "description": "Brightdesk Workspace — desktop productivity software",
  "main": "src/main.js",
  "author": {
    "name": "Brightdesk",
    "email": "noreply@github.com"
  },
  "license": "MIT",
  "engines": {
    "node": "24.22.2"
  },
  "scripts": {
    "check:node": "node scripts/check-node24.js",
    "start": "electron .",
    "test": "node --test",
    "dist": "npm run native:build && npm run verify:licenses && electron-builder --publish never",
    "dist:win": "npm run native:build && npm run verify:licenses && node scripts/build-app.js loop win",
    "dist:mac": "npm run native:build && npm run verify:licenses && node scripts/build-app.js loop mac",
    "dist:linux": "npm run native:build && npm run verify:licenses && node scripts/build-app.js loop linux",
    "release": "npm run native:build && npm run verify:licenses && electron-builder --publish never",
    "verify:licenses": "node scripts/verify-licenses.js",
    "postinstall": "npm run verify:licenses",
    "release:preflight": "node scripts/release-preflight.js",
    "release:verify:win": "node scripts/verify-release-artifacts.js win",
    "release:verify:mac": "node scripts/verify-release-artifacts.js mac",
    "release:verify:linux": "node scripts/verify-release-artifacts.js linux",
    "release:prepare": "node scripts/prepare-release-assets.js",
    "lock:prepare": "npm install --package-lock-only --ignore-scripts --no-audit --no-fund",
    "lock:verify": "node scripts/verify-lockfile.js",
    "setup:dev": "node scripts/setup/bootstrap-dev.js",
    "rea:inspect": "node scripts/brightdesk-rea.js inspect",
    "dist:desktop:win": "npm run dist:win",
    "dist:desktop:mac": "npm run dist:mac",
    "dist:desktop:linux": "npm run dist:linux",
    "verify:desktop:win": "node scripts/verify-desktop-installers.js win release/apps loop",
    "verify:desktop:mac": "node scripts/verify-desktop-installers.js mac release/apps loop",
    "verify:desktop:linux": "node scripts/verify-desktop-installers.js linux release/apps loop",
    "rust:fmt": "cargo fmt --manifest-path rust/Cargo.toml --all",
    "rust:test": "cargo test --manifest-path rust/Cargo.toml --workspace",
    "rust:build": "cargo build --manifest-path rust/Cargo.toml --workspace --release",
    "rust:check": "npm run rust:fmt && cargo clippy --manifest-path rust/Cargo.toml --workspace --all-targets -- -D warnings && npm run rust:test && npm run native:build",
    "native:build": "node scripts/build-native.js",
    "dist:app:win": "node scripts/build-app.js loop win",
    "dist:app:mac": "node scripts/build-app.js loop mac",
    "dist:app:linux": "node scripts/build-app.js loop linux",
    "verify:app:win": "node scripts/verify-standalone-apps.js win release/apps loop",
    "verify:app:mac": "node scripts/verify-standalone-apps.js mac release/apps loop",
    "verify:app:linux": "node scripts/verify-standalone-apps.js linux release/apps loop"
  },
  "dependencies": {
    "docx": "9.15.1",
    "electron-updater": "6.8.11",
    "exceljs": "4.4.0",
    "fast-xml-parser": "5.11.2",
    "jszip": "3.10.2",
    "mammoth": "1.12.2",
    "nspell": "2.1.5",
    "pptxgenjs": "4.0.1"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "overrides": {
    "pptxgenjs": {
      "image-size": "2.0.4"
    }
  },
  "build": {
    "appId": "org.brightdesk.loop",
    "productName": "Brightdesk Workspace",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "TERMS_AND_CONDITIONS.txt",
      "native/brightdesk_engine.node"
    ],
    "directories": {
      "output": "release"
    },
    "publish": [],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Brightdesk-Workspace-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "license": "TERMS_AND_CONDITIONS.txt"
    },
    "mac": {
      "target": [
        "dmg",
        "pkg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "artifactName": "Brightdesk-Workspace-${version}-${arch}.${ext}"
    },
    "dmg": {
      "sign": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "artifactName": "brightdesk-workspace-${version}-${arch}.${ext}"
    },
    "appImage": {
      "artifactName": "Brightdesk-Workspace-${version}-${arch}.${ext}"
    },
    "pkg": {
      "license": "TERMS_AND_CONDITIONS.txt",
      "welcome": "installer/mac-welcome.txt",
      "conclusion": "installer/mac-conclusion.txt",
      "installLocation": "/Applications"
    },
    "asarUnpack": [
      "native/brightdesk_engine.node"
    ]
  },
  "brightdeskAppId": "loop"
}
